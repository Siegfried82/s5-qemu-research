+def _resolve_image_path(trace_dir, raw_path):
+    if not isinstance(raw_path, str) or not raw_path or "\x00" in raw_path:
+        raise ValueError(f"Invalid image source_path: {raw_path!r}")
+    if ".." in PurePosixPath(raw_path.replace("\\", "/")).parts:
+        raise ValueError(f"Path traversal rejected in source_path: {raw_path!r}")
+    root = trace_dir.resolve()
+    p = Path(raw_path)
+    if p.is_absolute():
+        candidate = p if p.resolve(strict=False).is_relative_to(root) else (trace_dir / p.name)
+    else:
+        candidate = trace_dir / p
+    resolved = candidate.resolve(strict=False)
+    if not resolved.is_relative_to(root) or not resolved.is_file():
+        raise FileNotFoundError(f"Missing or out-of-tree image dependency: {resolved}")
+    return resolved
+
